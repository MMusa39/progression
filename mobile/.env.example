# Copy to `.env` and fill in. Restart `npx expo start` after changes.
# All EXPO_PUBLIC_* values are embedded in the app bundle, so never put secrets here.

# API base URL. Leave unset in development to auto-detect your Mac's LAN address.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080

# Amazon Cognito: values from the outputs of `cdk deploy Progression-Auth` (see infra/README.md).
EXPO_PUBLIC_COGNITO_REGION=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_DOMAIN=

# Set to true once the Google identity provider is deployed (GoogleSignInEnabled output = true).
EXPO_PUBLIC_GOOGLE_SIGN_IN=false
